<Project Sdk="Microsoft.NET.Sdk">

  <!-- View-model tests: net8.0-windows because it references the WPF App project. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MeticulousResearch.App\MeticulousResearch.App.csproj" />
    <ProjectReference Include="..\..\src\MeticulousResearch.Core\MeticulousResearch.Core.csproj" />
    <ProjectReference Include="..\MeticulousResearch.TestSupport\MeticulousResearch.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
