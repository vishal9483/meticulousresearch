<Application x:Class="MeticulousResearch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeticulousResearch.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme tokens (Light.xaml/Dark.xaml) are inserted at runtime by WpfThemeApplier
                     so a live theme switch swaps a single dictionary. Control styles reference the
                     tokens via DynamicResource. -->
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Views/ViewLocator.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
