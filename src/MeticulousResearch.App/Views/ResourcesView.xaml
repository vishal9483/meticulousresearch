<UserControl x:Class="MeticulousResearch.App.Views.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:MeticulousResearch.App.ViewModels.Sections"
             d:DataContext="{d:DesignInstance sections:ResourcesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Resources center-pane view (SPEC §3.2): add-text entry, a table of resources, and a
         preview pane for the selected resource's extracted text. Scrollable at narrow widths. -->
    <Grid x:Name="ResourcesRoot" Margin="24" AllowDrop="True"
          AutomationProperties.AutomationId="ResourcesRoot"
          DragOver="OnResourcesDragOver" Drop="OnResourcesDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" />
        </StackPanel>

        <!-- Add resource → Paste text -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Add resource → Paste text" FontWeight="SemiBold" />
                <TextBox x:Name="DraftTitleBox" Margin="0,8,0,0"
                         AutomationProperties.AutomationId="ResourceTitleInput"
                         Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox x:Name="DraftTextBox" Margin="0,8,0,0" MinHeight="72"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.AutomationId="ResourceTextInput"
                         Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock x:Name="ValidationError" Margin="0,8,0,0" Foreground="#C0392B"
                           AutomationProperties.AutomationId="ResourceValidationError"
                           Text="{Binding ValidationError}"
                           Visibility="{Binding HasValidationError,
                                        Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add pasted text" Padding="12,6"
                            AutomationProperties.AutomationId="AddPastedTextButton"
                            Command="{Binding AddPastedTextCommand}" />
                    <Button Content="Upload file…" Padding="12,6" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="UploadFileButton"
                            Click="OnUploadFileClick" />
                </StackPanel>
                <!-- Async extraction progress indicator -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            AutomationProperties.AutomationId="ExtractionProgress"
                            Visibility="{Binding IsExtracting,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" />
                    <TextBlock Text="Extracting…" Margin="8,0,0,0" Foreground="#555" />
                </StackPanel>
                <TextBlock x:Name="UploadHint" Margin="0,8,0,0" Foreground="#B26A00" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ResourceUploadHint"
                           Text="{Binding UploadHint}"
                           Visibility="{Binding HasUploadHint,
                                        Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Add resource → URL -->
                <TextBlock Text="Add resource → URL" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBox x:Name="DraftUrlBox" Margin="0,8,0,0"
                         AutomationProperties.AutomationId="ResourceUrlInput"
                         Text="{Binding DraftUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock x:Name="UrlValidationError" Margin="0,8,0,0" Foreground="#C0392B"
                           AutomationProperties.AutomationId="ResourceUrlValidationError"
                           Text="{Binding UrlValidationError}"
                           Visibility="{Binding HasUrlValidationError,
                                        Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Add URL" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AddUrlButton"
                        Command="{Binding AddUrlCommand}" />
                <!-- Fetch progress indicator -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            AutomationProperties.AutomationId="FetchProgress"
                            Visibility="{Binding IsFetching,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" />
                    <TextBlock Text="Fetching…" Margin="8,0,0,0" Foreground="#555" />
                </StackPanel>
                <TextBlock x:Name="UrlError" Margin="0,8,0,0" Foreground="#C0392B" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ResourceUrlError"
                           Text="{Binding UrlError}"
                           Visibility="{Binding HasUrlError,
                                        Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Resources table -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <DataGrid x:Name="ResourcesTable" ItemsSource="{Binding Resources}"
                          SelectedItem="{Binding SelectedResource}"
                          AutoGenerateColumns="False" IsReadOnly="False"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          AutomationProperties.AutomationId="ResourcesTable">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="Auto" IsReadOnly="True" />
                        <DataGridTextColumn Header="Size" Binding="{Binding ByteSize}" Width="Auto" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tokens" Binding="{Binding TokenEstimate}" Width="Auto" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto" IsReadOnly="False" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Enabled-scope token total (disabled resources excluded) -->
                <TextBlock DockPanel.Dock="Bottom" Margin="4,8,0,0" Foreground="#555"
                           AutomationProperties.AutomationId="ResourcesEnabledTotal"
                           VerticalAlignment="Bottom"
                           Text="{Binding EnabledTokenTotal, StringFormat='Enabled scope: {0} tokens'}" />

                <!-- Designed empty state for a project with no resources -->
                <TextBlock Text="{Binding EmptyStateMessage}" Foreground="#999" TextWrapping="Wrap"
                           VerticalAlignment="Top" Margin="4,8,0,0"
                           AutomationProperties.AutomationId="ResourcesEmptyState"
                           Visibility="{Binding IsEmpty,
                                        Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!-- Preview pane -->
            <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                    Padding="12" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" x:Name="PreviewMetadata" Margin="0,0,0,8"
                               Foreground="#555" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ResourcePreviewMetadata"
                               Text="{Binding SelectedMetadata}"
                               Visibility="{Binding HasSelection,
                                            Converter={StaticResource BoolToVisibilityConverter}}" />
                    <!-- Manage actions for the selected resource -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding HasSelection,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Re-extract" Padding="10,4"
                                AutomationProperties.AutomationId="ReExtractResourceButton"
                                IsEnabled="{Binding CanReExtractSelected}"
                                Command="{Binding ReExtractSelectedCommand}" />
                        <Button Content="Remove" Padding="10,4" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="RemoveResourceButton"
                                Command="{Binding RemoveSelectedCommand}" />
                    </StackPanel>
                    <!-- Remove confirmation prompt: nothing is deleted until confirmed -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" CornerRadius="4"
                            BorderBrush="#C0392B" BorderThickness="1"
                            AutomationProperties.AutomationId="RemoveConfirm"
                            Visibility="{Binding IsConfirmingRemove,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Remove this resource? This deletes its files and cannot be undone."
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Confirm remove" Padding="10,4"
                                        AutomationProperties.AutomationId="ConfirmRemoveButton"
                                        Command="{Binding ConfirmRemoveCommand}" />
                                <Button Content="Cancel" Padding="10,4" Margin="8,0,0,0"
                                        AutomationProperties.AutomationId="CancelRemoveButton"
                                        Command="{Binding CancelRemoveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" x:Name="PreviewSourceUri" Margin="0,0,0,8"
                               Foreground="#3366CC" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ResourcePreviewSourceUri"
                               Text="{Binding SelectedSourceUri}"
                               Visibility="{Binding HasSelectedSourceUri,
                                            Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PreviewPane" Text="{Binding PreviewText}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ResourcePreview" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
