<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MeticulousResearch.App.ViewModels"
                    xmlns:sections="clr-namespace:MeticulousResearch.App.ViewModels.Sections"
                    xmlns:views="clr-namespace:MeticulousResearch.App.Views">

    <!-- MVVM view-location: each view-model type maps to its view. Later features add their own
         DataTemplate here (or in a merged dictionary) so no destination is a placeholder. -->

    <DataTemplate DataType="{x:Type vm:ProjectsHomeViewModel}">
        <views:ProjectsHomeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProjectWorkspaceViewModel}">
        <views:ProjectWorkspaceView />
    </DataTemplate>

    <!-- Design-system component gallery (renders the styled kit). -->
    <DataTemplate DataType="{x:Type vm:ThemeGalleryViewModel}">
        <views:ThemeGalleryView />
    </DataTemplate>

    <!-- App-level Settings screen (secure key, endpoint, preferences, data directory). -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>

    <!-- All project sections share the designed SectionView until later features specialize them. -->
    <DataTemplate DataType="{x:Type sections:ConversationsViewModel}">
        <views:ConversationsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sections:ResourcesViewModel}">
        <views:ResourcesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sections:ArtifactsViewModel}">
        <views:SectionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sections:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sections:ProjectSettingsViewModel}">
        <views:SectionView />
    </DataTemplate>

</ResourceDictionary>
