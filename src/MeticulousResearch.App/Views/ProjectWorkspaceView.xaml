<UserControl x:Class="MeticulousResearch.App.Views.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeticulousResearch.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:ProjectWorkspaceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid x:Name="WorkspaceRoot">
        <Grid.ColumnDefinitions>
            <!-- Left nav: fixed-min so it stays usable; center: fills; right: contextual. -->
            <ColumnDefinition Width="200" MinWidth="160" />
            <ColumnDefinition Width="*" MinWidth="240" />
            <ColumnDefinition Width="260" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- Left pane: project section navigation -->
        <Border Grid.Column="0" Background="#F5F6F8" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <ItemsControl x:Name="LeftNav" ItemsSource="{Binding Sections}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding Title}"
                                     GroupName="Sections"
                                     Margin="0,2"
                                     Padding="10,8"
                                     HorizontalContentAlignment="Left"
                                     Command="{Binding DataContext.SelectSectionCommand,
                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding Section}"
                                     AutomationProperties.Name="{Binding Title}">
                            <RadioButton.IsChecked>
                                <MultiBinding Mode="OneWay">
                                    <MultiBinding.Converter>
                                        <vm:SectionActiveConverter />
                                    </MultiBinding.Converter>
                                    <Binding Path="Section" />
                                    <Binding Path="DataContext.ActiveSection"
                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </RadioButton.IsChecked>
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                        Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#DCE6FA" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#EAEFF9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Center pane: active section -->
        <ContentControl Grid.Column="1" x:Name="CenterPane" Content="{Binding CurrentSection}" />

        <!-- Right pane: contextual (present but may be empty) -->
        <Border Grid.Column="2" x:Name="RightPane" Background="#FAFAFB"
                BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
            <TextBlock Text="Context" Margin="16" Foreground="#999" VerticalAlignment="Top" />
        </Border>
    </Grid>
</UserControl>
