<UserControl x:Class="MeticulousResearch.App.Views.TemplateGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeticulousResearch.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:TemplateGalleryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Deliverable-template gallery (SPEC §3.4.1): each template's name, description, and a
         scaffold-derived preview, surfaced in the New-artifact and New-project flows. -->
    <ScrollViewer Background="{DynamicResource SurfaceBrush}">
        <StackPanel Margin="24" x:Name="TemplateGalleryRoot"
                    AutomationProperties.AutomationId="TemplateGallery">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <ItemsControl ItemsSource="{Binding Templates}"
                          AutomationProperties.AutomationId="TemplateGalleryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="12" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                AutomationProperties.AutomationId="TemplateGalleryItem"
                                AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"
                                           AutomationProperties.AutomationId="TemplateName" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="TemplateDescription" />
                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="TemplatePreview" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
