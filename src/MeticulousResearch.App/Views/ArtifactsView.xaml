<UserControl x:Class="MeticulousResearch.App.Views.ArtifactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:MeticulousResearch.App.ViewModels.Sections"
             d:DataContext="{d:DesignInstance sections:ArtifactsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Artifacts center-pane view (SPEC §3.4): the list of the project's deliverables, a "New
         artifact" entry point, a designed empty state when the project has no artifacts yet, and
         the editor's diff mode (two version pickers, side-by-side / inline, highlighted changes). -->
    <Grid x:Name="ArtifactsRoot" Margin="24"
          AutomationProperties.AutomationId="ArtifactsRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" />
        </StackPanel>

        <Button Grid.Row="1" Content="New artifact" Padding="12,6" Margin="0,16,0,0"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="NewArtifactButton"
                Command="{Binding NewArtifactCommand}" />

        <!-- Designed empty state. -->
        <StackPanel Grid.Row="2" Margin="0,24,0,0" VerticalAlignment="Top"
                    AutomationProperties.AutomationId="ArtifactsEmptyState"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static sections:ArtifactsViewModel.EmptyStateMessage}"
                       TextWrapping="Wrap" Foreground="#777" />
        </StackPanel>

        <!-- Artifact list. -->
        <ListBox Grid.Row="2" Margin="0,16,0,0"
                 AutomationProperties.AutomationId="ArtifactsList"
                 ItemsSource="{Binding Artifacts}"
                 SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                 Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Type}" Margin="8,0,0,0" Foreground="#888" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Edit with Claude prompt bar (SPEC §3.4, §9.1(5)): appears when an artifact is selected.
             A follow-up instruction input, a per-edit model selector, a streaming preview, and a
             commit/keep action. Errors surface inline; a successful edit commits a new version. -->
        <Border Grid.Row="3" Margin="0,16,0,0" BorderThickness="1" BorderBrush="#DDD" Padding="12"
                AutomationProperties.AutomationId="EditWithClaudeBar"
                Visibility="{Binding EditWithClaude, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel DataContext="{Binding EditWithClaude}">
                <TextBlock Text="Edit with Claude" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox Width="360"
                             AutomationProperties.AutomationId="EditWithClaudeInstruction"
                             Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="200" Margin="8,0,0,0"
                              AutomationProperties.AutomationId="EditWithClaudeModelPicker"
                              ItemsSource="{Binding ModelPicker.Tiers}"
                              DisplayMemberPath="Name" />
                    <Button Content="Edit" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="EditWithClaudeButton"
                            Command="{Binding EditCommand}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="EditWithClaudePreview"
                           Text="{Binding PreviewContent}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#C00"
                           AutomationProperties.AutomationId="EditWithClaudeError"
                           Text="{Binding ErrorMessage}" />
            </StackPanel>
        </Border>

        <!-- Diff mode (SPEC §3.4): appears when an artifact is selected. Two version pickers,
             side-by-side / inline toggle, highlighted changes, and a disabled hint when only one
             version exists. -->
        <Border Grid.Row="4" Margin="0,16,0,0" BorderThickness="1" BorderBrush="#DDD" Padding="12"
                AutomationProperties.AutomationId="ArtifactDiffPanel"
                Visibility="{Binding Diff, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel DataContext="{Binding Diff}">
                <!-- Disabled hint (single version). -->
                <TextBlock AutomationProperties.AutomationId="DiffDisabledHint"
                           Text="{Binding DisabledHint}"
                           TextWrapping="Wrap" Foreground="#999"
                           Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Diff controls + presentation (two or more versions). -->
                <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Base" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="220"
                                  AutomationProperties.AutomationId="DiffBasePicker"
                                  ItemsSource="{Binding Versions}"
                                  SelectedItem="{Binding BaseVersion, Mode=TwoWay}"
                                  DisplayMemberPath="VersionNo" />
                        <TextBlock Text="Compare" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <ComboBox Width="220"
                                  AutomationProperties.AutomationId="DiffComparePicker"
                                  ItemsSource="{Binding Versions}"
                                  SelectedItem="{Binding CompareVersion, Mode=TwoWay}"
                                  DisplayMemberPath="VersionNo" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Side by side" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="DiffSideBySideButton"
                                Command="{Binding ShowSideBySideCommand}" />
                        <Button Content="Inline"
                                AutomationProperties.AutomationId="DiffInlineButton"
                                Command="{Binding ShowInlineCommand}" />
                    </StackPanel>

                    <!-- Side-by-side presentation: base left, compare right. -->
                    <Grid Margin="0,12,0,0"
                          AutomationProperties.AutomationId="DiffSideBySideView"
                          Visibility="{Binding IsSideBySide, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" Margin="0,0,6,0"
                                      AutomationProperties.AutomationId="DiffLeftPane"
                                      ItemsSource="{Binding LeftSegments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" Margin="6,0,0,0"
                                      AutomationProperties.AutomationId="DiffRightPane"
                                      ItemsSource="{Binding RightSegments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Inline presentation: merged single pane. -->
                    <ItemsControl Margin="0,12,0,0"
                                  AutomationProperties.AutomationId="DiffInlineView"
                                  ItemsSource="{Binding InlineSegments}"
                                  Visibility="{Binding IsInline, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>