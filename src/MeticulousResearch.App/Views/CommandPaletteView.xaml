<UserControl x:Class="MeticulousResearch.App.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeticulousResearch.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:CommandPaletteViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AutomationProperties.AutomationId="CommandPaletteRoot"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Command palette overlay (SPEC §3.5): a focused search box over a ranked result list with a
         designed empty state. Opened by Ctrl+K; Esc dismisses (handled by the shell). The
         AutomationId lives on the UserControl root (surfaces to UIA; a Border does not). -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource PrimaryNavyBrush}" BorderThickness="1"
            CornerRadius="8" Width="560" MaxHeight="440"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0"
            Padding="12">
        <DockPanel>
            <TextBox DockPanel.Dock="Top"
                     x:Name="SearchBox"
                     AutomationProperties.AutomationId="CommandPaletteSearchBox"
                     AutomationProperties.Name="Command palette search"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="8" Margin="0,0,0,8" />

            <!-- Designed empty state — never a raw error (SPEC §9.1(10)). -->
            <TextBlock DockPanel.Dock="Bottom"
                       x:Name="EmptyState"
                       AutomationProperties.AutomationId="CommandPaletteEmptyState"
                       Text="{Binding EmptyStateMessage}"
                       Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                       Foreground="{DynamicResource OnSurfaceBrush}"
                       Margin="8,8" />

            <ListBox x:Name="ResultsList"
                     AutomationProperties.AutomationId="CommandPaletteResults"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex}"
                     Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ShortcutHint}"
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       Margin="12,0,0,0" />
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
