<UserControl x:Class="MeticulousResearch.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:MeticulousResearch.App.ViewModels.Sections"
             d:DataContext="{d:DesignInstance sections:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Project dashboard center-pane view: counts, last activity, and quick actions (SPEC §3.1).
         Scrollable so content is never clipped at narrow widths (@ui resize scenario). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24" x:Name="DashboardRoot">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" />

            <!-- Counts -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ResourceCount}" FontSize="24" FontWeight="Bold"
                                   AutomationProperties.AutomationId="ResourceCount" />
                        <TextBlock Text="Resources" Foreground="#777" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ConversationCount}" FontSize="24" FontWeight="Bold"
                                   AutomationProperties.AutomationId="ConversationCount" />
                        <TextBlock Text="Conversations" Foreground="#777" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding ArtifactCount}" FontSize="24" FontWeight="Bold"
                                   AutomationProperties.AutomationId="ArtifactCount" />
                        <TextBlock Text="Artifacts" Foreground="#777" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Last activity -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="Last activity: " Foreground="#777" />
                <TextBlock Text="{Binding LastActivity}" AutomationProperties.AutomationId="LastActivity" />
            </StackPanel>

            <!-- Consolidated cost panel (cost-tracking, SPEC §3.6, §9.1(7)): total spend with
                 breakdowns by conversations-vs-artifacts, by model, and by time window. -->
            <Border x:Name="ConsolidatedCostPanel" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                    Padding="16" Margin="0,20,0,0"
                    AutomationProperties.AutomationId="ConsolidatedCostPanel">
                <StackPanel DataContext="{Binding CostPanel}">
                    <TextBlock Text="Cost" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalDisplay}" FontSize="24" FontWeight="Bold"
                               AutomationProperties.AutomationId="CostTotal" />

                    <!-- By source: conversations vs artifacts -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                AutomationProperties.AutomationId="CostBySource">
                        <TextBlock Text="Conversations: " Foreground="#777" />
                        <TextBlock Text="{Binding ConversationsDisplay}"
                                   AutomationProperties.AutomationId="CostConversations" />
                        <TextBlock Text="   Artifacts: " Foreground="#777" />
                        <TextBlock Text="{Binding ArtifactsDisplay}"
                                   AutomationProperties.AutomationId="CostArtifacts" />
                    </StackPanel>

                    <!-- By model -->
                    <TextBlock Text="By model" Foreground="#777" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding ByModel}"
                                  AutomationProperties.AutomationId="CostByModel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Model}" MinWidth="160" />
                                    <TextBlock Text="{Binding CostDisplay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- By time window -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                AutomationProperties.AutomationId="CostByWindow">
                        <TextBlock Text="Today: " Foreground="#777" />
                        <TextBlock Text="{Binding Today}" AutomationProperties.AutomationId="CostToday" />
                        <TextBlock Text="   This week: " Foreground="#777" />
                        <TextBlock Text="{Binding Week}" AutomationProperties.AutomationId="CostWeek" />
                        <TextBlock Text="   All time: " Foreground="#777" />
                        <TextBlock Text="{Binding AllTime}" AutomationProperties.AutomationId="CostAllTime" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quick actions -->
            <TextBlock Text="Quick actions" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ItemsControl x:Name="QuickActions" ItemsSource="{Binding QuickActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" AutomationProperties.Name="{Binding}"
                                Padding="12,8" Margin="0,0,8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
