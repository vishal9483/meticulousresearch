<UserControl x:Class="MeticulousResearch.App.Views.ConversationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:MeticulousResearch.App.ViewModels.Sections"
             d:DataContext="{d:DesignInstance sections:ConversationsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Conversations center-pane view (SPEC §3.3): a scrollable thread of user/assistant turns,
         a designed empty state, and a composer. Streaming/model-selector/turn-actions layer on
         later via the view-model hooks. -->
    <Grid x:Name="ConversationsRoot" Margin="24"
          AutomationProperties.AutomationId="ConversationsRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" />
        </StackPanel>

        <!-- Conversation thread -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConversationThread"
                              AutomationProperties.AutomationId="ConversationThread"
                              ItemsSource="{Binding Turns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6" Padding="12" CornerRadius="8"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold"
                                               Foreground="#555" />
                                    <TextBlock Text="{Binding Content}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Designed empty state, shown only when the thread has no turns -->
            <StackPanel x:Name="EmptyState"
                        AutomationProperties.AutomationId="ConversationEmptyState"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No messages yet" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#666" />
                <TextBlock Text="Ask your first question to start a grounded conversation."
                           Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center" Foreground="#888" />
            </StackPanel>
        </Grid>

        <!-- Composer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="MessageInput" MinHeight="40"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="MessageInput"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Send" Padding="16,8" Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="SendButton"
                    Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</UserControl>
