<UserControl x:Class="MeticulousResearch.App.Views.ConversationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:MeticulousResearch.App.ViewModels.Sections"
             d:DataContext="{d:DesignInstance sections:ConversationsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Conversations center-pane view (SPEC §3.3): a scrollable thread of user/assistant turns,
         a designed empty state, and a composer. Streaming/model-selector/turn-actions layer on
         later via the view-model hooks. -->
    <Grid x:Name="ConversationsRoot" Margin="24"
          AutomationProperties.AutomationId="ConversationsRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" />

            <!-- Model picker (model-selector, SPEC §6, §3.3): friendly tiers plus an "All models"
                 expander, with an advisory vision warning + switch action. -->
            <StackPanel x:Name="ModelPicker" Orientation="Horizontal" Margin="0,10,0,0"
                        AutomationProperties.AutomationId="ModelPicker"
                        DataContext="{Binding ModelPicker}">
                <TextBlock Text="Model:" VerticalAlignment="Center" Foreground="#555" />
                <TextBlock x:Name="CurrentModelLabel" Margin="6,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           AutomationProperties.AutomationId="CurrentModelLabel"
                           Text="{Binding CurrentModelLabel}" />

                <ItemsControl x:Name="ModelTiers" Margin="12,0,0,0"
                              AutomationProperties.AutomationId="ModelTiers"
                              ItemsSource="{Binding Tiers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4,0,0,0" Padding="10,4"
                                    Content="{Binding Tier}"
                                    AutomationProperties.Name="{Binding Tier}"
                                    Command="{Binding DataContext.SelectModelCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander x:Name="AllModelsExpander" Margin="12,0,0,0" Header="All models"
                          AutomationProperties.AutomationId="AllModelsExpander"
                          AutomationProperties.Name="All models">
                    <ItemsControl AutomationProperties.AutomationId="AllModelsList"
                                  ItemsSource="{Binding AdditionalModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,2" Padding="8,4"
                                        HorizontalContentAlignment="Left"
                                        Content="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SelectModelCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <!-- Advisory vision warning (SPEC §3.2.1): shown when a non-vision model is chosen with
                 an image in scope; offers a one-click switch to a vision-capable model. -->
            <Border x:Name="VisionWarning" Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                    Background="#FFF4E5" BorderBrush="#F0C36D" BorderThickness="1"
                    DataContext="{Binding ModelPicker}"
                    AutomationProperties.AutomationId="VisionWarning"
                    Visibility="{Binding HasVisionWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="#8A6D3B"
                               Text="{Binding VisionWarning.Message}" TextWrapping="Wrap" />
                    <Button Margin="10,0,0,0" Padding="10,4" Content="Switch model"
                            AutomationProperties.AutomationId="SwitchModelButton"
                            AutomationProperties.Name="Switch model"
                            Command="{Binding SwitchToVisionModelCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>


        <!-- Conversation thread -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConversationThread"
                              AutomationProperties.AutomationId="ConversationThread"
                              ItemsSource="{Binding Turns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6" Padding="12" CornerRadius="8"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold"
                                               Foreground="#555" />
                                    <TextBlock Text="{Binding Content}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <!-- Model that produced this assistant turn (model-selector, SPEC §3.3). -->
                                    <TextBlock x:Name="TurnModelLabel" Margin="0,4,0,0"
                                               FontSize="11" Foreground="#888"
                                               AutomationProperties.AutomationId="TurnModelLabel"
                                               AutomationProperties.Name="{Binding ModelLabel}"
                                               Text="{Binding ModelLabel}"
                                               Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Designed empty state, shown only when the thread has no turns -->
            <StackPanel x:Name="EmptyState"
                        AutomationProperties.AutomationId="ConversationEmptyState"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="No messages yet" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#666" />
                <TextBlock Text="Ask your first question to start a grounded conversation."
                           Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center" Foreground="#888" />
            </StackPanel>
        </Grid>

        <!-- Composer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="MessageInput" MinHeight="40"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="MessageInput"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Send" Padding="16,8" Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="SendButton"
                    Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</UserControl>
