<UserControl x:Class="MeticulousResearch.App.Views.ConversationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:MeticulousResearch.App.ViewModels.Sections"
             d:DataContext="{d:DesignInstance sections:ConversationsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AutomationProperties.AutomationId="ConversationsRoot"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <!-- Conversations center-pane view (SPEC §3.3): a scrollable thread of user/assistant turns,
         a designed empty state, and a composer. Streaming/model-selector/turn-actions layer on
         later via the view-model hooks. -->
    <Grid x:Name="ConversationsRoot" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" />

            <!-- Model picker (model-selector, SPEC §6, §3.3): friendly tiers plus an "All models"
                 expander, with an advisory vision warning + switch action. Wrapped in a ScrollViewer
                 so the container id surfaces to UIA (a StackPanel does not). -->
            <ScrollViewer x:Name="ModelPicker" Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="ModelPicker"
                          DataContext="{Binding ModelPicker}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Model:" VerticalAlignment="Center" Foreground="#555" />
                <TextBlock x:Name="CurrentModelLabel" Margin="6,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           AutomationProperties.AutomationId="CurrentModelLabel"
                           Text="{Binding CurrentModelLabel}" />

                <ItemsControl x:Name="ModelTiers" Margin="12,0,0,0"
                              AutomationProperties.AutomationId="ModelTiers"
                              ItemsSource="{Binding Tiers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4,0,0,0" Padding="10,4"
                                    Content="{Binding Tier}"
                                    AutomationProperties.Name="{Binding Tier}"
                                    Command="{Binding DataContext.SelectModelCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander x:Name="AllModelsExpander" Margin="12,0,0,0" Header="All models"
                          AutomationProperties.AutomationId="AllModelsExpander"
                          AutomationProperties.Name="All models">
                    <ItemsControl AutomationProperties.AutomationId="AllModelsList"
                                  ItemsSource="{Binding AdditionalModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,2" Padding="8,4"
                                        HorizontalContentAlignment="Left"
                                        Content="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SelectModelCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
              </StackPanel>
            </ScrollViewer>

            <!-- Advisory vision warning (SPEC §3.2.1): shown when a non-vision model is chosen with
                 an image in scope; offers a one-click switch to a vision-capable model. -->
            <Border x:Name="VisionWarning" Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                    Background="#FFF4E5" BorderBrush="#F0C36D" BorderThickness="1"
                    DataContext="{Binding ModelPicker}"
                    AutomationProperties.AutomationId="VisionWarning"
                    Visibility="{Binding HasVisionWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="#8A6D3B"
                               Text="{Binding VisionWarning.Message}" TextWrapping="Wrap" />
                    <Button Margin="10,0,0,0" Padding="10,4" Content="Switch model"
                            AutomationProperties.AutomationId="SwitchModelButton"
                            AutomationProperties.Name="Switch model"
                            Command="{Binding SwitchToVisionModelCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>


        <!-- Conversation thread -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Conversation-header running cost (cost-tracking, SPEC §3.6): the thread's live
                 running total, recomputed from stored tokens at current prices as turns complete. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Running cost: " Foreground="#777" />
                <TextBlock Text="{Binding RunningCostDisplay}" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="ConversationRunningCost" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConversationThread"
                              AutomationProperties.AutomationId="ConversationThread"
                              ItemsSource="{Binding Turns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6" Padding="12" CornerRadius="8"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold"
                                               Foreground="#555" />
                                    <TextBlock Text="{Binding Content}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <!-- Streaming cursor/indicator (streaming, SPEC §3.3): shown while
                                         tokens are arriving; clears on completion. -->
                                    <TextBlock x:Name="StreamingIndicator" Margin="0,4,0,0"
                                               FontSize="12" Foreground="#0A7"
                                               Text="▌ streaming…"
                                               AutomationProperties.AutomationId="StreamingIndicator"
                                               AutomationProperties.Name="Streaming"
                                               Visibility="{Binding IsStreamingIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <!-- Interrupted affordance (streaming, SPEC §8): a stopped/faulted
                                         turn shows it was interrupted and offers a resume/retry action. -->
                                    <StackPanel x:Name="InterruptedNotice" Orientation="Horizontal"
                                                Margin="0,6,0,0"
                                                AutomationProperties.AutomationId="InterruptedNotice"
                                                Visibility="{Binding IsInterrupted, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock VerticalAlignment="Center" Foreground="#B00"
                                                   FontSize="12" Text="Interrupted"
                                                   AutomationProperties.AutomationId="InterruptedBadge"
                                                   AutomationProperties.Name="Interrupted" />
                                        <Button Margin="10,0,0,0" Padding="10,2" Content="Resume"
                                                AutomationProperties.AutomationId="ResumeButton"
                                                AutomationProperties.Name="Resume"
                                                Command="{Binding ResumeCommand}" />
                                    </StackPanel>
                                    <!-- Model that produced this assistant turn (model-selector, SPEC §3.3). -->
                                    <TextBlock x:Name="TurnModelLabel" Margin="0,4,0,0"
                                               FontSize="11" Foreground="#888"
                                               AutomationProperties.AutomationId="TurnModelLabel"
                                               AutomationProperties.Name="{Binding ModelLabel}"
                                               Text="{Binding ModelLabel}"
                                               Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Per-turn metadata, cost badge, and actions (turn-metadata-actions,
                                         SPEC §3.3, §3.6): an inline cost badge with an expandable full
                                         breakdown, an expandable metadata panel (model/tokens/latency/
                                         resource scope), and an action menu (copy, retry same/other model,
                                         edit & resend, promote to artifact, delete). Shown once the turn's
                                         persisted metadata is attached. -->
                                    <ScrollViewer x:Name="TurnActions" Margin="0,8,0,0"
                                                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.AutomationId="TurnActions"
                                                  DataContext="{Binding Actions}"
                                                  Visibility="{Binding DataContext.HasActions,
                                                      RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border},
                                                      Converter={StaticResource BoolToVisibilityConverter}}">
                                      <StackPanel>
                                        <!-- Inline cost badge with a full breakdown on expand (§3.6). -->
                                        <Expander x:Name="CostBadge" Header="{Binding CostBadge}"
                                                  AutomationProperties.AutomationId="CostBadge"
                                                  AutomationProperties.Name="{Binding CostBadge}">
                                            <TextBlock x:Name="CostBreakdown" FontSize="12" Foreground="#666"
                                                       AutomationProperties.AutomationId="CostBreakdown"
                                                       Text="{Binding CostBreakdownDetail}" TextWrapping="Wrap" />
                                        </Expander>

                                        <!-- Expandable per-turn metadata panel (§3.3). -->
                                        <Expander x:Name="TurnMetadata" Header="Details" Margin="0,4,0,0"
                                                  AutomationProperties.AutomationId="TurnMetadata"
                                                  AutomationProperties.Name="Details">
                                            <StackPanel>
                                                <TextBlock AutomationProperties.AutomationId="MetadataModel"
                                                           FontSize="12" Foreground="#666"
                                                           Text="{Binding ModelLabel, StringFormat='Model: {0}'}" />
                                                <TextBlock AutomationProperties.AutomationId="MetadataInputTokens"
                                                           FontSize="12" Foreground="#666"
                                                           Text="{Binding InputTokens, StringFormat='Input tokens: {0}'}" />
                                                <TextBlock AutomationProperties.AutomationId="MetadataOutputTokens"
                                                           FontSize="12" Foreground="#666"
                                                           Text="{Binding OutputTokens, StringFormat='Output tokens: {0}'}" />
                                                <TextBlock AutomationProperties.AutomationId="MetadataLatency"
                                                           FontSize="12" Foreground="#666"
                                                           Text="{Binding LatencyLabel, StringFormat='Latency: {0}'}" />
                                                <TextBlock AutomationProperties.AutomationId="MetadataResourceScope"
                                                           FontSize="12" Foreground="#666" TextWrapping="Wrap"
                                                           Text="{Binding ResourceScopeLabel, StringFormat='Resources: {0}'}" />
                                            </StackPanel>
                                        </Expander>

                                        <!-- Action menu (§3.3). -->
                                        <Menu x:Name="TurnActionMenu" Margin="0,4,0,0" Background="Transparent"
                                              AutomationProperties.AutomationId="TurnActionMenu">
                                            <MenuItem Header="Actions" AutomationProperties.Name="Actions">
                                                <MenuItem Header="Copy"
                                                          AutomationProperties.AutomationId="CopyAction"
                                                          AutomationProperties.Name="Copy"
                                                          Command="{Binding CopyCommand}" />
                                                <MenuItem Header="Retry"
                                                          AutomationProperties.AutomationId="RetryAction"
                                                          AutomationProperties.Name="Retry"
                                                          Command="{Binding RetryCommand}" />
                                                <MenuItem Header="Retry with other model"
                                                          AutomationProperties.AutomationId="RetryOtherModelAction"
                                                          AutomationProperties.Name="Retry with other model"
                                                          Command="{Binding RetryWithOtherModelCommand}" />
                                                <MenuItem Header="Edit &amp; resend"
                                                          AutomationProperties.AutomationId="EditResendAction"
                                                          AutomationProperties.Name="Edit &amp; resend"
                                                          Command="{Binding EditAndResendCommand}" />
                                                <MenuItem Header="Promote to artifact"
                                                          AutomationProperties.AutomationId="PromoteAction"
                                                          AutomationProperties.Name="Promote to artifact"
                                                          Command="{Binding PromoteCommand}" />
                                                <MenuItem Header="Delete"
                                                          AutomationProperties.AutomationId="DeleteAction"
                                                          AutomationProperties.Name="Delete"
                                                          Command="{Binding DeleteCommand}" />
                                            </MenuItem>
                                        </Menu>
                                      </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- "Retrying…" indicator (rate-limit-backoff, SPEC §8): a non-alarming, attempt-numbered
                 banner shown while a rate-limited / transient turn is being retried; it is not an
                 error dialog and never shows a raw status code. Clears on resolution. -->
            <Border x:Name="RetryingIndicator" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Margin="0,0,0,8" Padding="10,6" CornerRadius="6"
                    Background="#EAF3FF" BorderBrush="#9CC3F0" BorderThickness="1"
                    DataContext="{Binding RetryStatus}"
                    AutomationProperties.AutomationId="RetryingIndicator"
                    AutomationProperties.Name="{Binding StatusText}"
                    Visibility="{Binding IsRetrying, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock VerticalAlignment="Center" Foreground="#1F5FA8"
                           AutomationProperties.AutomationId="RetryingIndicatorText"
                           Text="{Binding StatusText}" TextWrapping="Wrap" />
            </Border>

            <!-- Designed empty state, shown only when the thread has no turns. Wrapped in a
                 ScrollViewer so the container id surfaces to UIA (a StackPanel does not). -->
            <ScrollViewer x:Name="EmptyState"
                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          AutomationProperties.AutomationId="ConversationEmptyState"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="No messages yet" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#666" />
                    <TextBlock Text="Ask your first question to start a grounded conversation."
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360"
                               TextAlignment="Center" Foreground="#888" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Composer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="MessageInput" MinHeight="40"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="MessageInput"
                     Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Send" Padding="16,8" Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="SendButton"
                    Command="{Binding SendCommand}" />
            <!-- Stop control (streaming, SPEC §3.5): cancels an in-progress generation; shown only
                 while streaming. -->
            <Button Grid.Column="1" Content="Stop" Padding="16,8" Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="StopButton"
                    AutomationProperties.Name="Stop"
                    Command="{Binding StopCommand}"
                    Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
