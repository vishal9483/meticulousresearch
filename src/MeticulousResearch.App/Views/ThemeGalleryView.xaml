<UserControl x:Class="MeticulousResearch.App.Views.ThemeGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeticulousResearch.App.ViewModels"
             xmlns:controls="clr-namespace:MeticulousResearch.App.Controls"
             d:DataContext="{d:DesignInstance vm:ThemeGalleryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Component gallery: one of each styled control so the themed kit renders and is
         @ui-drivable. All controls pick up the implicit design-system styles. -->
    <ScrollViewer Background="{DynamicResource SurfaceBrush}">
        <StackPanel Margin="24" x:Name="ThemeGalleryRoot"
                    AutomationProperties.AutomationId="ThemeGalleryRoot">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Button Content="Primary action" AutomationProperties.AutomationId="GalleryButton"
                    HorizontalAlignment="Left" Margin="0,4" />

            <TextBox Text="Sample text" AutomationProperties.AutomationId="GalleryTextBox"
                     Width="240" HorizontalAlignment="Left" Margin="0,4" />

            <ComboBox ItemsSource="{Binding SampleOptions}" SelectedIndex="0"
                      AutomationProperties.AutomationId="GalleryComboBox"
                      Width="240" HorizontalAlignment="Left" Margin="0,4" />

            <DataGrid ItemsSource="{Binding SampleRows}" AutoGenerateColumns="True"
                      AutomationProperties.AutomationId="GalleryDataGrid"
                      IsReadOnly="True" Height="120" Margin="0,4" />

            <!-- ThemedDialog/ThemedToast derive from ContentControl, which does not surface to
                 UIA; a disabled ScrollViewer wrapper carries the queried id so the @ui theming
                 tests can find the styled control. -->
            <ScrollViewer AutomationProperties.AutomationId="GalleryDialog"
                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Left" Margin="0,12">
                <controls:ThemedDialog Title="Sample dialog">
                    <TextBlock Text="Dialogs use the themed chrome." />
                </controls:ThemedDialog>
            </ScrollViewer>

            <ScrollViewer AutomationProperties.AutomationId="GalleryToast"
                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Left" Margin="0,12">
                <controls:ThemedToast Severity="info">
                    <TextBlock Text="Toasts use the themed chrome." />
                </controls:ThemedToast>
            </ScrollViewer>
        </StackPanel>
    </ScrollViewer>
</UserControl>
