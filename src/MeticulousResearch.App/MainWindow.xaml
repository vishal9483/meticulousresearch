<Window x:Class="MeticulousResearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeticulousResearch.App"
        xmlns:vm="clr-namespace:MeticulousResearch.App.ViewModels"
        xmlns:views="clr-namespace:MeticulousResearch.App.Views"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        mc:Ignorable="d"
        Title="MeticulousResearch"
        Height="800" Width="1200" MinWidth="1024" MinHeight="640"
        WindowState="Maximized" ResizeMode="CanResize">
    <!-- The whole shell surface. A disabled ScrollViewer (not a Grid) carries the AppSurface id so
         it surfaces to UIA (the surfacing rule: a Grid does not) while still filling the window. -->
    <ScrollViewer x:Name="AppSurface" AutomationProperties.AutomationId="AppSurface"
                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource SurfaceBrush}">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- @ui-only design-system component gallery (design-system-theming). Mounted behind the
             shell (lowest z-order, covered by the nav + content) so its styled controls are
             reachable by the theming @ui tests without a navigation seam. Collapsed in normal use;
             the code-behind shows it only under the @ui harness (METICULOUS_UI_SEED). -->
        <views:ThemeGalleryView x:Name="ThemeGallery" Grid.Column="0" Grid.ColumnSpan="2"
                                Visibility="Collapsed" />

        <!-- @ui-only branded onboarding welcome step (onboarding / app-branding-icon). Mounted
             behind the shell so the onboarding presence assertions resolve without a first-run
             launch mode (which would hide the Projects home the rest of the @ui suite relies on).
             Collapsed in normal use; shown only under the @ui harness. -->
        <views:OnboardingView x:Name="OnboardingHost" Grid.Column="0" Grid.ColumnSpan="2"
                              Visibility="Collapsed" />

        <!-- @ui-only app Settings screen (settings-secure-key / onboarding re-run / about entry).
             Mounted behind the shell so the settings presence assertions resolve without a
             navigation step. Collapsed in normal use; shown only under the @ui harness. -->
        <views:SettingsView x:Name="SettingsHost" Grid.Column="0" Grid.ColumnSpan="2"
                            Visibility="Collapsed" />

        <!-- Top-level navigation rail (root: Projects). -->
        <Border Grid.Column="0" Background="{DynamicResource PrimaryNavyBrush}" MinWidth="180">
            <DockPanel LastChildFill="False" Margin="8,12">
                <TextBlock DockPanel.Dock="Top" Text="MeticulousResearch"
                           Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="15" Margin="8,0,8,16" TextWrapping="Wrap" />
                <ItemsControl DockPanel.Dock="Top" x:Name="TopNav" ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Margin="0,2" Padding="10,8"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"
                                    Command="{Binding DataContext.GoHomeCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- App-level quick theme toggle (design-system-theming); Settings surfaces the
                     full Light/Dark/System choice later. -->
                <Button DockPanel.Dock="Bottom" x:Name="ThemeToggle"
                        AutomationProperties.AutomationId="ThemeToggle"
                        Content="Toggle theme" Margin="0,8" Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Background="Transparent" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"
                        Click="ThemeToggle_Click" />
                <!-- App-level Settings entry (settings-secure-key/about-screen); the About screen is
                     reached from here. -->
                <Button DockPanel.Dock="Bottom" x:Name="OpenSettingsButton"
                        AutomationProperties.AutomationId="OpenSettingsButton"
                        Content="Settings" Margin="0,8" Padding="10,8"
                        HorizontalContentAlignment="Left"
                        Background="Transparent" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"
                        Command="{Binding GoToSettingsCommand}" />
            </DockPanel>
        </Border>

        <!-- Content region: the current view-model, resolved to a view via DataTemplates. -->
        <ContentControl Grid.Column="1" x:Name="ContentRegion" Content="{Binding CurrentViewModel}" />

        <!-- Command palette overlay (command-palette-shortcuts, SPEC §3.5). Spans the whole
             surface, dimming the app behind a centered palette. Toggled by Ctrl+K / Esc in
             code-behind so focus can be trapped and restored. -->
        <Grid x:Name="PaletteOverlay" Grid.Column="0" Grid.ColumnSpan="2"
              AutomationProperties.AutomationId="CommandPaletteOverlay"
              Background="#99000000" Visibility="Collapsed">
            <views:CommandPaletteView x:Name="Palette" />
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
