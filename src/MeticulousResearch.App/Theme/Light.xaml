<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme design tokens. Values mirror MeticulousResearch.Core.Theming.DesignTokens
         (the @unit-tested source of truth); keep the two in sync. Views reference the semantic
         *Brush roles, never these raw colors. -->

    <Color x:Key="PrimaryNavyColor">#1B2A4A</Color>
    <Color x:Key="AccentColor">#2E5AAC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceVariantColor">#F3F4F6</Color>
    <Color x:Key="OnSurfaceColor">#1A1D21</Color>
    <Color x:Key="PrimaryButtonFillColor">#1B2A4A</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="FocusIndicatorColor">#2E5AAC</Color>
    <Color x:Key="SuccessColor">#1E7E34</Color>
    <Color x:Key="WarningColor">#8A5A00</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>

    <SolidColorBrush x:Key="PrimaryNavyBrush" Color="{StaticResource PrimaryNavyColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <!-- On-accent foreground for text drawn on the accent/navy fills. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Accessibility: primary-button fill/text and the keyboard focus indicator (accessibility/phase.md). -->
    <SolidColorBrush x:Key="PrimaryButtonFillBrush" Color="{StaticResource PrimaryButtonFillColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="FocusIndicatorBrush" Color="{StaticResource FocusIndicatorColor}" />

</ResourceDictionary>
