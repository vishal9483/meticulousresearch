<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:MeticulousResearch.App.Controls">

    <!-- =========================================================================================
         Design-system control kit. Implicit styles (keyed by type) so standard controls pick up
         the themed look automatically and no screen shows default WPF chrome
         (design-system-theming/phase.md #5). Colors come from the swappable theme dictionary via
         DynamicResource so a live theme switch restyles everything with no restart.
         ========================================================================================= -->

    <!-- 8px spacing scale. -->
    <Thickness x:Key="SpacingXs">4</Thickness>
    <Thickness x:Key="SpacingSm">8</Thickness>
    <Thickness x:Key="SpacingMd">16</Thickness>
    <Thickness x:Key="SpacingLg">24</Thickness>

    <!-- Type scale (UI sans; report serif option surfaced for branded-export). -->
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="ReportSerifFontFamily">Georgia</FontFamily>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>

    <!-- Shared application-icon brand asset (app-branding-icon/phase.md, SPEC §3.7). The final
         multi-resolution application icon, exposed under the "AppIcon" key that about-screen and
         onboarding already consume, so the same brand mark shows on the window, About screen, and
         first-run welcome. -->
    <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/AppIcon.ico" />

    <!-- Shared keyboard focus adorner. A high-contrast dashed ring drawn from the theme focus
         token so focus is clearly visible in both themes (accessibility/phase.md #3, SPEC §3.7).
         Interactive control styles below reference this via FocusVisualStyle. -->
    <Style x:Key="AppFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle x:Name="FocusAdorner"
                               Margin="-2" StrokeThickness="2" RadiusX="4" RadiusY="4"
                               Stroke="{DynamicResource FocusIndicatorBrush}"
                               StrokeDashArray="2 2" SnapsToDevicePixels="True"
                               AutomationProperties.AutomationId="FocusAdorner" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: filled accent with a fully custom template (not the OS default appearance). -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <!-- Button labels follow the button Foreground, overriding the
                                     app-wide implicit TextBlock style (which sets OnSurface). -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox: themed surface, accent focus border. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryNavyBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox: themed surface + foreground. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryNavyBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
    </Style>

    <!-- DataGrid: themed surface, navy header, accent selection. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceVariantBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryNavyBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource PrimaryNavyBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBlock: themed body text on surfaces. -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- ThemedDialog: styled modal surface. -->
    <Style TargetType="controls:ThemedDialog">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ThemedDialog">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PrimaryNavyBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="16" MinWidth="320">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Title}"
                                       FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,12" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ThemedToast: styled transient notification. -->
    <Style TargetType="controls:ThemedToast">
        <Setter Property="Background" Value="{DynamicResource PrimaryNavyBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ThemedToast">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="12,10" MinWidth="240">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================================
         Shared view-state controls (empty-loading-error-states/phase.md #2). Every view reuses
         these so no pane is ever blank and no raw stack trace is shown (SPEC §3.7, §9.1(10)).
         ========================================================================================= -->

    <!-- Designed empty state: message + call-to-action button. -->
    <Style TargetType="controls:EmptyState">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EmptyState">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SurfaceVariantBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="24"
                            AutomationProperties.AutomationId="EmptyState">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Message}"
                                       AutomationProperties.AutomationId="EmptyStateMessage"
                                       FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Content="{TemplateBinding CallToAction}"
                                    Command="{TemplateBinding CallToActionCommand}"
                                    AutomationProperties.AutomationId="EmptyStateCallToAction"
                                    HorizontalAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Designed error state: human-readable message + recovery button (never a stack trace). -->
    <Style TargetType="controls:ErrorState">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ErrorState">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="24"
                            AutomationProperties.AutomationId="ErrorState">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Message}"
                                       AutomationProperties.AutomationId="ErrorStateMessage"
                                       FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Content="{TemplateBinding RecoveryAction}"
                                    Command="{TemplateBinding RecoveryCommand}"
                                    AutomationProperties.AutomationId="ErrorStateRecoveryButton"
                                    HorizontalAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skeleton loader: shimmer placeholder rows shown while loading (purely visual). -->
    <Style TargetType="controls:SkeletonLoader">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SkeletonLoader">
                    <ItemsControl AutomationProperties.AutomationId="SkeletonLoader"
                                  Focusable="False">
                        <ItemsControl.ItemsSource>
                            <x:Array Type="{x:Type sys:Object}">
                                <sys:Object /><sys:Object /><sys:Object />
                            </x:Array>
                        </ItemsControl.ItemsSource>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="16" Margin="0,0,0,12" CornerRadius="4"
                                        Background="{DynamicResource SurfaceVariantBrush}" Opacity="0.6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

