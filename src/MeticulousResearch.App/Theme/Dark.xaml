<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme design tokens. Values mirror MeticulousResearch.Core.Theming.DesignTokens
         (the @unit-tested source of truth); keep the two in sync. -->

    <Color x:Key="PrimaryNavyColor">#24365C</Color>
    <Color x:Key="AccentColor">#7FA8E8</Color>
    <Color x:Key="SurfaceColor">#12161C</Color>
    <Color x:Key="SurfaceVariantColor">#1C222B</Color>
    <Color x:Key="OnSurfaceColor">#E6E8EB</Color>
    <Color x:Key="SuccessColor">#5CD07A</Color>
    <Color x:Key="WarningColor">#E0A94B</Color>
    <Color x:Key="ErrorColor">#F2726A</Color>

    <SolidColorBrush x:Key="PrimaryNavyBrush" Color="{StaticResource PrimaryNavyColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <!-- On-accent foreground for text drawn on the accent/navy fills. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0E12" />

</ResourceDictionary>
